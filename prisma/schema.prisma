  level_name_en String?   @db.VarChar(255)
  display_order Int?      @default(0)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([section_type, level_type, display_order], map: "idx_homepage_materials_section_type")
}

model language_course_prices {
  id                Int              @id @default(autoincrement())
  course_id         Int?
  language_level_id Int?
  price             Decimal          @db.Decimal(10, 2)
  courses           courses?         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  language_levels   language_levels? @relation(fields: [language_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([course_id, language_level_id])
}

model language_levels {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(50)
  description            String
  language_id            Int?
  order                  Int?                     @default(1)
  is_active              Boolean?                 @default(true)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  courses                courses[]
  language_course_prices language_course_prices[]
  languages              languages?               @relation(fields: [language_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  live_sections          live_sections[]
  live_sessions          live_sessions[]

  @@index([is_active], map: "idx_language_levels_active")
  @@index([language_id], map: "idx_language_levels_language_id")
  @@index([order], map: "idx_language_levels_order")
}

model languages {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  code            String            @unique @db.VarChar(10)
  flag            String?           @db.VarChar(255)
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  language_levels language_levels[]
  live_sections   live_sections[]
  live_sessions   live_sessions[]

  @@index([is_active], map: "idx_languages_active")
  @@index([code], map: "idx_languages_code")
}

model levels {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(100)
  live_sections          live_sections[]
  private_class_requests private_class_requests[]
  users                  users[]
  years                  years[]
}

model live_private {
  id                                     Int                         @id @default(autoincrement())
  title                                  String                      @db.VarChar(255)
  description                            String?
  scheduled_at                           DateTime                    @db.Timestamp(6)
  professor_id                           Int?
  created_by                             Int?
