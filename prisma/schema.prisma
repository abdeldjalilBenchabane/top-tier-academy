  video_url             String?                 @db.VarChar(500)
  media_type            String                  @default("image") @db.VarChar(20)
  order                 Int                     @default(0)
  is_active             Boolean?                @default(true)
  duration              Int?
  start_date            DateTime?               @db.Timestamp(6)
  end_date              DateTime?               @db.Timestamp(6)
  target_audience       String[]
  cta_text              String?                 @db.VarChar(100)
  cta_link              String?                 @db.VarChar(500)
  overlay_color         String?                 @default("#000000") @db.VarChar(7)
  overlay_opacity       Decimal?                @default(0.3) @db.Decimal(3, 2)
  transition            String?                 @default("fade") @db.VarChar(20)
  alt_text              String?                 @db.VarChar(255)
