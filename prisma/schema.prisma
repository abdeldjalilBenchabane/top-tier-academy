  @@index([is_active], map: "idx_enhanced_slides_active")
  @@index([created_at], map: "idx_enhanced_slides_created_at")
  @@index([order], map: "idx_enhanced_slides_order")
}

model file_uploads {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  file_url    String    @db.VarChar(255)
  file_type   String?   @db.VarChar(50)
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model footer_content {
  id            Int       @id @default(autoincrement())
  section_name  String    @db.VarChar(100)
  content_key   String    @db.VarChar(100)
  content_value String
  content_type  String?   @default("text") @db.VarChar(50)
  display_order Int?      @default(0)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([section_name, content_key])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model homepage_materials {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  section_type  String    @db.VarChar(50)
  level_type    String    @db.VarChar(50)
