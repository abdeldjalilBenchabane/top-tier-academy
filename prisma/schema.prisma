}

model live_private_participants {
  id              Int           @id @default(autoincrement())
  live_private_id Int?
  user_id         Int?
  joined_at       DateTime?     @default(now()) @db.Timestamp(6)
  live_private    live_private? @relation(fields: [live_private_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([live_private_id], map: "idx_live_private_participants_live_private_id")
  @@index([user_id], map: "idx_live_private_participants_user_id")
}

