// Prisma schema for top-tier.academy.
//
// GENERATED FROM THE LIVE DATABASE. This database already had its tables long
// before Prisma existed here, so the DATABASE is the source of truth and this
// file is a mirror of it — not the other way round.
//
// NOTE: `prisma db pull` overwrites this file and drops this header. If you
// run it, paste this block back at the top.
//
//   npm run db:pull      re-read the database into this file after a SQL change
//   npm run db:generate  rebuild the typed client from this file
//   npm run db:studio    browse the data in a local UI (via an SSH tunnel)
//
// DANGER — never run these against production:
//   prisma migrate dev / prisma migrate reset / prisma db push
// They drop and recreate tables. The app manages its own schema in SQL (see
// backend/migrations/applied/); Prisma here is for reading and typed queries.
//
// Credentials: prisma/.env is a symlink to ../backend/.env, so there is one
// set of credentials. It is deliberately NOT at the project root — vite loads
// the root .env and would bake any VITE_* secret into the public browser bundle.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activities {
  id         Int       @id @default(autoincrement())
  student_id Int?
  type       String?   @db.VarChar(50)
  title      String?   @db.VarChar(255)
  time       DateTime? @default(now()) @db.Timestamp(6)
  related_id Int?
  extra      Json?     @db.Json
  users      users?    @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model chat_messages {
  id           Int       @id @default(autoincrement())
  session_id   String    @db.VarChar(255)
  user_id      Int
  user_name    String    @db.VarChar(255)
  user_role    String    @db.VarChar(50)
  message_text String
  timestamp    DateTime? @default(now()) @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@index([session_id], map: "idx_chat_messages_session_id")
  @@index([timestamp], map: "idx_chat_messages_timestamp")
}

model chat_notifications {
  id                   Int       @id @default(autoincrement())
  user_id              Int
  session_id           String    @db.VarChar(255)
  last_seen_message_id String?   @default("0") @db.VarChar(255)
  unseen_count         Int?      @default(0)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)

  @@unique([user_id, session_id])
}

model comment_replies {
  id              Int             @id @default(autoincrement())
  comment_id      Int
  user_id         Int?
  user_name       String?         @db.VarChar(100)
  user_role       String?         @db.VarChar(32)
  reply_text      String
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  course_comments course_comments @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?          @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model comments {
  id              Int              @id @default(autoincrement())
  user_id         Int?
  course_id       Int?
  section_id      Int?
  content         String
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  courses         courses?         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_sections course_sections? @relation(fields: [section_id], references: [id], onUpdate: NoAction)
  users           users?           @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model course_comments {
  id              Int               @id @default(autoincrement())
  course_id       Int
  user_id         Int?
  section_id      Int?
  name            String            @db.VarChar(100)
  comment         String
  tab             String            @db.VarChar(32)
  rating          Int?
  reply           String?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  comment_replies comment_replies[]
  courses         courses           @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_sections course_sections?  @relation(fields: [section_id], references: [id], onUpdate: NoAction)
  users           users?            @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model course_covers {
  id         Int       @id @default(autoincrement())
  course_id  Int?      @unique
  cover      String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  courses    courses?  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "idx_course_covers_course_id")
}

model course_enrollments {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  course_id    Int?
  points_spent Int?      @default(0)
  enrolled_at  DateTime? @default(now()) @db.Timestamp(6)
  courses      courses?  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
}

model course_files {
  id              Int              @id @default(autoincrement())
  course_id       Int?
  section_id      Int?
  block_id        Int?
  file_name       String           @db.VarChar(255)
  file_path       String           @db.VarChar(500)
  file_type       String           @db.VarChar(100)
  file_size       Int?
  original_name   String           @db.VarChar(255)
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  section_blocks  section_blocks?  @relation(fields: [block_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courses         courses?         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_sections course_sections? @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([block_id], map: "idx_course_files_block_id")
  @@index([course_id], map: "idx_course_files_course_id")
  @@index([section_id], map: "idx_course_files_section_id")
}

model course_sections {
  id              Int               @id @default(autoincrement())
  course_id       Int?
  title           String            @db.VarChar(255)
  order           Int?
  comments        comments[]
  course_comments course_comments[]
  course_files    course_files[]
  courses         courses?          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  section_blocks  section_blocks[]
}

model courses {
  id                     Int                      @id @default(autoincrement())
  title                  String                   @db.VarChar(255)
  description            String?
  material_id            Int?
  created_by             Int?
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  approved_at            DateTime?                @db.Timestamp(6)
  price                  Decimal?                 @db.Decimal(10, 2)
  is_published           Boolean?                 @default(false)
  status                 String                   @default("draft") @db.VarChar(50)
  language_level_id      Int?
  comments               comments[]
  course_comments        course_comments[]
  course_covers          course_covers?
  course_enrollments     course_enrollments[]
  course_files           course_files[]
  course_sections        course_sections[]
  users                  users?                   @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  materials              materials?               @relation(fields: [material_id], references: [id], onUpdate: NoAction)
  language_levels        language_levels?         @relation(fields: [language_level_id], references: [id], onUpdate: NoAction, map: "fk_language_level_id")
  language_course_prices language_course_prices[]
  quizzes                quizzes[]
  student_courses        student_courses[]
  video_security_logs    video_security_logs[]
  video_views            video_views[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model enhanced_slides {
